# Local paths used by Hydra and artifact writers.
# These defaults assume commands are run from the repository root.
BONSAI_CONFIG_PATH=./configs
BONSAI_MODELS=./data/models
BONSAI_PROCESSED_DATA=./data/processed_data
BONSAI_PREDICTIONS=./data/predictions
BONSAI_CHECKPOINT_ROOT=./data/checkpoints
BONSAI_RESULTS_ROOT=./data/results

# Shared production hematology artifacts. BONSAI_PROCESSED_DATA is the parent
# used by dataset-based Hydra configs; sweep configs resolve hematology_all
# beneath it through the experiment registry.
BONSAI_COHORT_MEMBERSHIP=./data/processed_data/hematology_all/population_full.csv
BONSAI_OUTCOMES_DIR=./data/processed_data/hematology_all/outcomes
