# Local paths used by Hydra and artifact writers.
# These defaults assume commands are run from the repository root.
BONSAI_CONFIG_PATH=./configs
BONSAI_MODELS=./data/models
BONSAI_PROCESSED_DATA=./data/processed_data
BONSAI_PREDICTIONS=./data/predictions
BONSAI_CHECKPOINT_ROOT=./data/checkpoints
BONSAI_RESULTS_ROOT=./data/results
