\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Construction of the longitudinal study population.} Haematology-relevant treatment records are assembled into candidate episodes, assigned to diseases using diagnoses recorded shortly after treatment when needed to accommodate coding lag, and filtered to a reconstructed first-line cohort. Initial assignment permits diagnoses through day 14; a coding-lag reassessment rescues unresolved patients with a window through day 90. Nine patients assigned an IgM monoclonal gammopathy of undetermined significance (MGUS) diagnosis are removed. A downstream survival-release rule also requires recorded death or end of follow-up to fall after treatment; its contribution to the 26 patients without a released supervised record awaits source-level reconciliation. The retrospective disease assignment is subject to an index-available-label sensitivity analysis for routed models. The self-supervised encoder uses pre-2022 histories from the 78,668-patient diagnosis-linked pretraining population. This is not patient-disjoint from the later supervised tuning and held-out cohorts. Sealed first-line metadata contains 37,557 patients; 37,531 have released overall-survival membership and a supervised split. The first-line counts shown are from the current mapped flow; the 26 patients without a released supervised split are shown separately. The supervised temporal split precedes outcome-specific eligibility and risk-set construction. Counts in the main nodes are unique patients; detailed attrition and endpoint-specific flows are provided in the supplement.}}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:cohort-flow}{{3}{9}{\textbf {Construction of the longitudinal study population.} Haematology-relevant treatment records are assembled into candidate episodes, assigned to diseases using diagnoses recorded shortly after treatment when needed to accommodate coding lag, and filtered to a reconstructed first-line cohort. Initial assignment permits diagnoses through day 14; a coding-lag reassessment rescues unresolved patients with a window through day 90. Nine patients assigned an IgM monoclonal gammopathy of undetermined significance (MGUS) diagnosis are removed. A downstream survival-release rule also requires recorded death or end of follow-up to fall after treatment; its contribution to the 26 patients without a released supervised record awaits source-level reconciliation. The retrospective disease assignment is subject to an index-available-label sensitivity analysis for routed models. The self-supervised encoder uses pre-2022 histories from the 78,668-patient diagnosis-linked pretraining population. This is not patient-disjoint from the later supervised tuning and held-out cohorts. Sealed first-line metadata contains 37,557 patients; 37,531 have released overall-survival membership and a supervised split. The first-line counts shown are from the current mapped flow; the 26 patients without a released supervised split are shown separately. The supervised temporal split precedes outcome-specific eligibility and risk-set construction. Counts in the main nodes are unique patients; detailed attrition and endpoint-specific flows are provided in the supplement}{figure.caption.4}{}}
\newlabel{fig:cohort-flow@cref}{{[figure][3][]3}{[1][2][]9}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The landscape of predictable outcomes across haematology.} Final artwork will be generated from the locked long-format results table; missing or unsupported cells remain visible as not estimable.}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:atlas}{{4}{10}{\textbf {The landscape of predictable outcomes across haematology.} Final artwork will be generated from the locked long-format results table; missing or unsupported cells remain visible as not estimable}{figure.caption.5}{}}
