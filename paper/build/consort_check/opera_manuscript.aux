\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cohort breadth and task breadth as additional axes of predictive information.} \textbf  {A}, conventional scaling increases the number of patients, variables, or observations available to an isolated prediction problem. \textbf  {B}, joint modelling can additionally draw on related disease cohorts (rows) and outcomes (columns), although greater breadth need not improve every target. Sharing is restricted to training data and acts through a common encoder and structured readout; it does not transfer future information or assume that diseases and endpoints are exchangeable.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:information}{{2}{4}{\textbf {Cohort breadth and task breadth as additional axes of predictive information.} \textbf {A}, conventional scaling increases the number of patients, variables, or observations available to an isolated prediction problem. \textbf {B}, joint modelling can additionally draw on related disease cohorts (rows) and outcomes (columns), although greater breadth need not improve every target. Sharing is restricted to training data and acts through a common encoder and structured readout; it does not transfer future information or assume that diseases and endpoints are exchangeable}{figure.caption.2}{}}
\newlabel{fig:information@cref}{{[figure][2][]2}{[1][2][]4}{}{}{}}
