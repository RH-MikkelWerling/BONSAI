\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Three paradigms for haematological risk prediction.} \textbf  {A}, Representative clinical risk scores combine a small diagnostic snapshot using a fixed rule and assign broad risk strata. \textbf  {B}, classical machine learning uses a wider history but ordinarily requires temporal aggregation into a task-specific feature table. \textbf  {C}, a longitudinal sequence model consumes ordered clinical events and can share a contextual patient representation across outcomes. Its encoder may be pretrained locally or at foundation-model scale. The comparison concerns information available to each predictor; it does not imply that every score or tabular implementation has exactly the illustrated structure.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:paradigms}{{1}{3}{\textbf {Three paradigms for haematological risk prediction.} \textbf {A}, Representative clinical risk scores combine a small diagnostic snapshot using a fixed rule and assign broad risk strata. \textbf {B}, classical machine learning uses a wider history but ordinarily requires temporal aggregation into a task-specific feature table. \textbf {C}, a longitudinal sequence model consumes ordered clinical events and can share a contextual patient representation across outcomes. Its encoder may be pretrained locally or at foundation-model scale. The comparison concerns information available to each predictor; it does not imply that every score or tabular implementation has exactly the illustrated structure}{figure.caption.1}{}}
\newlabel{fig:paradigms@cref}{{[figure][1][]1}{[1][2][]3}{}{}{}}
