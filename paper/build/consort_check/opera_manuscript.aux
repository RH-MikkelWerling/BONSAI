\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {When broader pretraining and joint learning add value.} The primary estimand is the paired held-out performance difference on identical patients, summarized hierarchically across tasks.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:scale-transfer}{{5}{10}{\textbf {When broader pretraining and joint learning add value.} The primary estimand is the paired held-out performance difference on identical patients, summarized hierarchically across tasks}{figure.caption.6}{}}
\newlabel{fig:scale-transfer@cref}{{[figure][5][]5}{[1][2][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Multi-outcome readout architectures.} Every model uses the same longitudinal encoder. \textbf  {A}, a shared linear head predicts all outcome-specific interval hazards from one patient summary. \textbf  {B}, an outcome MLP adds nonlinear task-specific capacity. \textbf  {C}, learned outcome queries attend to different portions of the sequence. \textbf  {D}, related outcomes share a nonlinear family trunk. \textbf  {E}, outcomes mix a small set of shared sequence-attention prototypes. \textbf  {F}, the factorized model combines global, cohort, outcome, and low-rank interaction effects to mix the same prototypes. Heads produce cause-specific interval hazards and cumulative incidence at all prespecified horizons; a multi-horizon binary cross-entropy objective is evaluated as an alternative to the exact-time likelihood.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:architectures}{{6}{10}{\textbf {Multi-outcome readout architectures.} Every model uses the same longitudinal encoder. \textbf {A}, a shared linear head predicts all outcome-specific interval hazards from one patient summary. \textbf {B}, an outcome MLP adds nonlinear task-specific capacity. \textbf {C}, learned outcome queries attend to different portions of the sequence. \textbf {D}, related outcomes share a nonlinear family trunk. \textbf {E}, outcomes mix a small set of shared sequence-attention prototypes. \textbf {F}, the factorized model combines global, cohort, outcome, and low-rank interaction effects to mix the same prototypes. Heads produce cause-specific interval hazards and cumulative incidence at all prespecified horizons; a multi-horizon binary cross-entropy objective is evaluated as an alternative to the exact-time likelihood}{figure.caption.7}{}}
\newlabel{fig:architectures@cref}{{[figure][6][]6}{[1][3][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Source-anchored disease--outcome routing.} For each patient and target outcome, the router mixes a shared representation with residual adapters indexed by fine disease and outcome. Its weights depend on the patient, disease and target; sources with no training support are masked and low-event sources are shrunk. An adapter is updated by its own eligible supervision, while borrowed adapter parameters are detached. The mixed representation enters a shared linear head for interval hazards and cumulative incidence. This is a model schematic, not an empirical route-weight or performance plot.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:source-router}{{7}{11}{\textbf {Source-anchored disease--outcome routing.} For each patient and target outcome, the router mixes a shared representation with residual adapters indexed by fine disease and outcome. Its weights depend on the patient, disease and target; sources with no training support are masked and low-event sources are shrunk. An adapter is updated by its own eligible supervision, while borrowed adapter parameters are detached. The mixed representation enters a shared linear head for interval hazards and cumulative incidence. This is a model schematic, not an empirical route-weight or performance plot}{figure.caption.8}{}}
\newlabel{fig:source-router@cref}{{[figure][7][]7}{[1][3][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Two-by-two router source-type ablation.} All arms retain the same Time2Vec initialization, pooled training patients and outcomes, interacting patient--disease--target query, shared path, hazard head, loss, and checkpoint rule. Only eligibility of disease-indexed and outcome-indexed adapter source banks changes. A-to-B and C-to-D estimate the conditional disease-source effect; A-to-C and B-to-D estimate the conditional outcome-source effect. The difference of these differences describes source-type interaction. No performance result is implied by panel placement or color.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:router-source-factorial}{{8}{11}{\textbf {Two-by-two router source-type ablation.} All arms retain the same Time2Vec initialization, pooled training patients and outcomes, interacting patient--disease--target query, shared path, hazard head, loss, and checkpoint rule. Only eligibility of disease-indexed and outcome-indexed adapter source banks changes. A-to-B and C-to-D estimate the conditional disease-source effect; A-to-C and B-to-D estimate the conditional outcome-source effect. The difference of these differences describes source-type interaction. No performance result is implied by panel placement or color}{figure.caption.9}{}}
\newlabel{fig:router-source-factorial@cref}{{[figure][8][]8}{[1][3][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Sequence learning compared with task-specific tabular models.} All contrasts use paired held-out predictions and identical endpoint eligibility.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:model-comparison}{{9}{11}{\textbf {Sequence learning compared with task-specific tabular models.} All contrasts use paired held-out predictions and identical endpoint eligibility}{figure.caption.10}{}}
\newlabel{fig:model-comparison@cref}{{[figure][9][]9}{[1][3][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Clinical structure in the learned embedding space.} Probability surfaces are descriptive held-out smooths, not independent estimates of model discrimination or causal effects.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:representation}{{10}{12}{\textbf {Clinical structure in the learned embedding space.} Probability surfaces are descriptive held-out smooths, not independent estimates of model discrimination or causal effects}{figure.caption.11}{}}
\newlabel{fig:representation@cref}{{[figure][10][]10}{[1][4][]12}{}{}{}}
