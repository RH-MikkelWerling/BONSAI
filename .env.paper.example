# Paper workflow overlay. Copy onto the server's EXISTING .env using
# opera.run.configure_paper_env; preserve its other paths and credentials.
# Empty fields are required scientific inputs, never fallbacks to earlier runs.
OPERA_RELEASE_DIR=
OPERA_SEQUENCE_DATA_DIR=
BONSAI_COHORT_MEMBERSHIP=
BONSAI_OUTCOMES_DIR=

OPERA_PAPER_ROOT=./data/paper_256
OPERA_PAPER_BASE_CONFIG=
OPERA_PAPER_ROUTER_REFERENCE=
OPERA_PAPER_LOCAL_CKPT=
OPERA_PAPER_ROUTER_LOCK=
OPERA_PAPER_DECISIONS=
# Every model is trained once with this seed (no seed replication).
OPERA_PAPER_SEEDS=42
OPERA_PAPER_EPOCHS=30
# Epochs without tuning improvement before a fit stops (same in every arm).
OPERA_PAPER_PATIENCE=5
OPERA_PAPER_BATCH_SIZE=8
# Data-loading workers per fit; each prefetches whole logical batches.
OPERA_PAPER_NUM_WORKERS=2
OPERA_PAPER_MIN_LOCAL_EPOCHS=10
OPERA_PAPER_MIN_DAPT_EPOCHS=10
OPERA_PAPER_EXTERNAL_WIDTH=256
# Width of the local encoder (256, or 512 if the width probe wins); 64-dim heads.
OPERA_PAPER_LOCAL_WIDTH=256

# Folder of raw feature matrices at index: one per cohort, named by cohort_fine
# (e.g. DLBCL.pkl, TRANSFORMED_FL.parquet), plus all.<ext> (every supervised
# patient) for the pooled XGBoost. `features` prepares each into
# $OPERA_PAPER_ROOT/features/<name>__{sequence_matched,registry_augmented}.parquet.
OPERA_PAPER_FEATURE_DIR=
OPERA_PAPER_TABULAR_HORIZONS=30,60,90,180,365,730

OPERA_PAPER_EXTERNAL_SOURCE_CKPT=
OPERA_PAPER_EXTERNAL_SOURCE_VOCAB=
# Date the national extract must reach (end of the test period); external-data fails otherwise
OPERA_PAPER_EXTERNAL_REQUIRED_LATEST=
# National MEDS extract the PHAIR encoder was pretrained on (its own codes and
# numeric normalisation), and the create_data config with PHAIR's tokenisation
# settings. `external-data` takes our patients from it and tokenises them with
# the PHAIR vocabulary; the national arms and DAPT read those sequences.
OPERA_PAPER_EXTERNAL_MEDS_DIR=
OPERA_PAPER_EXTERNAL_DATA_CONFIG=daly_care_joined_bins_data
# Optional; defaults to $OPERA_PAPER_ROOT/external_sequences/sequences.
OPERA_PAPER_EXTERNAL_SEQUENCE_DIR=
# RoPE layout of the external source's training commit, required when it was
# trained with FlashAttention and its checkpoint does not record the layout:
# non_interleaved (upstream BONSAI before 2026-09-29/a3fa6ac) or interleaved.
OPERA_PAPER_EXTERNAL_SOURCE_ROPE_LAYOUT=
OPERA_PAPER_DAPT_BATCH_SIZE=1
OPERA_PAPER_DAPT_ACCUMULATION=128

# These are explicit server recipes; the analysis recipe is generated later
# by the inventory step using patient/cell metadata and the data-contract ID.
OPERA_PAPER_ANALYSIS_TEMPLATE=opera/configs/locked_prediction_analysis.example.yaml
OPERA_PAPER_ANALYSIS_ROOT=
# All six horizons: the horizon figures and the two-year IPI comparison need them.
OPERA_PAPER_ANALYSIS_HORIZONS=30,60,90,180,365,730
# binary_known_status_unweighted or cif_ipcw (full risk set, censoring-weighted,
# matches the native CIF evaluator). Use a separate ANALYSIS_ROOT per estimand.
OPERA_PAPER_ANALYSIS_ESTIMAND=cif_ipcw
OPERA_PAPER_DATA_CONTRACT=
OPERA_PAPER_PATIENT_METADATA=
# One row per patient: index, IPI, PS and the Table 1 groupings, from
# python -m opera.run.flatten_ipi_records --metadata <sealed>/population_metadata.parquet
# --output <path>. Used by Table 1 and the clinical-score comparison.
OPERA_PAPER_CLINICAL_METADATA=
# Local vocabulary.pt (history counts); subject_data_*.pt directory if it is
# not OPERA_SEQUENCE_DATA_DIR itself.
OPERA_PAPER_LOCAL_VOCAB=
# Index-date column in the membership file (first-line treatment start).
OPERA_PAPER_INDEX_DATE_COLUMN=index_date
# Date of the diagnosis that assigned the fine subtype (late-coded sensitivity).
OPERA_PAPER_IDENTITY_DATE_COLUMN=
OPERA_PAPER_SUBJECT_DATA_DIR=
# Table 1: raw MEDS root (data/train, data/tuning, data/held_out) for pre-index
# history; overall survival defaults to $BONSAI_OUTCOMES_DIR/overall_survival.parquet.
OPERA_PAPER_MEDS_DIR=
# Sex and birth date of the supervised patients, from the DALY-CARE patient table:
# Rscript opera/R/export_table1_patient_demographics.R <overall_survival.parquet> <out.parquet>
OPERA_PAPER_DEMOGRAPHICS=
OPERA_PAPER_OVERALL_SURVIVAL=
# Stages and calibration-map outcomes for the representation figures.
OPERA_PAPER_EMBEDDING_CONFIG=
OPERA_PAPER_CELL_METADATA=
# Held-out direct_cr_pooled_metrics.csv of the selected joint run (atlas figure).
OPERA_PAPER_ATLAS_METRICS=
# Template may be a metric-scale prior/tolerance lock derived from this example.
OPERA_PAPER_BAYES_TEMPLATE=opera/configs/bayesian_contrasts.example.yaml
# Optional JSON list; blank uses the six generated primary recipes.
OPERA_PAPER_BAYES_RECIPES=
# Audited registry of every applicable clinical-score/population pair.
# The configuration chosen on tuning data, analysed as OPERA (default R_L from the template)
OPERA_PAPER_OPERA_MODEL=
# The primary routed fit (lock amendment 2026-10-27: R_AB_L). Analysed as R_L, with the
# original router as R_ORIG_L; national routed fits get its readout. Empty: the original router.
OPERA_PAPER_ROUTED_MODEL=
OPERA_PAPER_CLINICAL_SCORE_CONFIG=
OPERA_PAPER_FIGURE_CONFIG=
# Real plot-ready CSV/JSON exports consumed by the complete figure recipe.
OPERA_PAPER_PLOT_TABLE_ROOT=
# Copy the full example recipe to the server and lock clinical choices first.
# OPERA_PAPER_FIGURE_CONFIG=opera/configs/paper_results_figures.full.example.yaml
# Optional; defaults to the initialised figure workspace's supplement_tables.yaml.
OPERA_PAPER_SUPPLEMENT_TABLE_CONFIG=
# Optional bounded explanation run: select checkpoint/config using tuning only.
OPERA_PAPER_ATTRIBUTION_CHECKPOINT=
OPERA_PAPER_ATTRIBUTION_CONFIG_NAME=
OPERA_PAPER_ATTRIBUTION_CONFIG_DIR=
OPERA_PAPER_ATTRIBUTION_CONFIG=opera/configs/attribution_analysis.example.yaml
